# Get a free TMDB API key (v3 auth) from https://www.themoviedb.org/settings/api
# and paste it below. This file is a TEMPLATE — never put a real key here.
# For local development, copy this file to `.env` and add your real key there.
# For Vercel hosting, add VITE_TMDB_API_KEY in the project dashboard under
# Settings > Environment Variables instead of committing any key.
VITE_TMDB_API_KEY=your_tmdb_api_key_here
